# Скопируйте в bench/bench.env (или сгенерируйте через chameleon-setup).
NODE_IP=192.0.2.10                 # RU-нода (вход)
NODE_SSH="ssh root@192.0.2.10"     # как зайти на ноду (ключ/пароль — ваши)
HUB_PORT=51899                     # порт ТЕСТОВОГО хаба (прод-хаб не трогается)
PORTBASE=0                         # >0: персональные порты пользователей portbase+слот
KEYS=1000                          # сколько виртуальных пользователей подготовить
HOLD=60; RAMP=20; WARM=15          # секунды: измерение / подключение / прогрев
ACTIVE=0.1; PPS=20; SIZE=1000      # доля активных, пакетов/с и байт на пакет у активного
SLA_ALIVE_PCT=99; SLA_P95_MS=500; SLA_LOSS_PCT=2   # критерий «сервер справляется»
PROFILES="1:512 2:1024"            # профили ресурсов vCPU:МБ для п.2
CAP_LEVELS="100 200 300 500 700 1000"
SCALE_PROFILE=2:1024               # ресурсы для п.3
SCALE_LEVELS="1 10 50 100 300 500"
SPEED_URL=https://speed.example.com/100MB.bin   # файл для п.1
SPEED_PATHS="direct ks"            # пути; для своих: SPEED_IF_<имя>=<интерфейс>
# SPEED_IF_wg=wg0
