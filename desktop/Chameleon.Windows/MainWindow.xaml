<Window x:Class="Chameleon.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Chameleon VPN" Width="900" Height="620" ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen"
 Background="{StaticResource Canvas}" FontFamily="Segoe UI" Foreground="White"
 UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="Auto"
 Loaded="LoadedWindow" Closing="ClosingWindow" Closed="ClosedWindow">
 <!-- Fixed-size window: no resizing and no scrolling. The Viewbox only shrinks the whole layout on very small screens. -->
 <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
 <Grid Width="884" Height="581"><Grid.ColumnDefinitions><ColumnDefinition Width="196"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Background="#141E2C" BorderBrush="#25354A" BorderThickness="0,0,1,0" Padding="18,24">
   <DockPanel LastChildFill="True">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,28">
     <StackPanel Orientation="Horizontal">
      <Border Background="{StaticResource Mint}" Width="34" Height="34" CornerRadius="10" Margin="0,0,9,0"><TextBlock Text="C" Foreground="#10212A" FontSize="25" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
      <TextBlock Text="Chameleon" FontWeight="SemiBold" FontSize="19" VerticalAlignment="Center"/>
     </StackPanel>
     <TextBlock Text="ПЕРСОНАЛЬНЫЙ VPN" Foreground="{StaticResource Muted}" FontSize="11" Margin="2,14,0,0"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom"><TextBlock Text="WINDOWS · x64 · Администратор" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock x:Name="VersionText" Text="beta" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
    <StackPanel>
     <Button x:Name="NavHome" Style="{StaticResource Nav}" Content="Подключение" Tag="Home" Click="Navigate"/>
     <Button x:Name="NavAccess" Style="{StaticResource Nav}" Content="Мой доступ" Tag="Access" Click="Navigate"/>
     <Button x:Name="NavProtocol" Style="{StaticResource Nav}" Content="Протокол" Tag="Protocol" Click="Navigate"/>
     <Button x:Name="NavDiagnostics" Style="{StaticResource Nav}" Content="Диагностика" Tag="Diagnostics" Click="Navigate"/>
     <Button x:Name="NavUpdates" Style="{StaticResource Nav}" Content="Обновления" Tag="Updates" Click="Navigate"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <DockPanel Grid.Column="1" Margin="28,24">
   <TextBlock DockPanel.Dock="Bottom" Text="Без рекламы и аналитики. Содержимое трафика не записывается. Закрытие окна сворачивает приложение в трей." Style="{StaticResource Sub}" FontSize="12" LineHeight="17" Margin="0,10,0,0"/>
   <Grid ClipToBounds="True">
    <StackPanel x:Name="Home">
     <TextBlock Text="Ваше подключение" Style="{StaticResource Heading}"/>
     <TextBlock Text="Персональный доступ. Одна кнопка для подключения." Style="{StaticResource Sub}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Padding="22">
      <StackPanel>
       <DockPanel Margin="0,0,0,16">
        <Border DockPanel.Dock="Left" Width="72" Height="72" Background="#223C53" CornerRadius="36" Margin="0,0,20,0" VerticalAlignment="Center">
         <Viewbox Width="34" Height="34"><Canvas Width="40" Height="40"><Path x:Name="PowerIcon" Data="M20,2 L20,20 M10,7 A17,17 0 1 0 30,7" Stroke="#8FC6FF" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
        </Border>
        <StackPanel VerticalAlignment="Center">
         <TextBlock x:Name="StatusTitle" Text="Проверяем службу" FontSize="24" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
         <TextBlock x:Name="StatusDetail" Text="Подключение ещё не установлено." Style="{StaticResource Sub}" FontSize="14" LineHeight="20" Margin="0,6,0,0" MaxHeight="60" TextTrimming="WordEllipsis"/>
        </StackPanel>
       </DockPanel>
       <ProgressBar x:Name="Progress" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,12"/>
       <Button x:Name="ConnectButton" Content="Подключить VPN" Style="{StaticResource Primary}" Click="Connect"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Padding="20,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><TextBlock Text="ПРОТОКОЛ" Style="{StaticResource Sub}" FontSize="11" LineHeight="15"/><TextBlock x:Name="SelectedProtocol" Text="AUTO" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/></StackPanel>
      <StackPanel Grid.Column="1"><TextBlock Text="ОТПРАВЛЕНО" Style="{StaticResource Sub}" FontSize="11" LineHeight="15"/><TextBlock x:Name="Uploaded" Text="0 Б" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
      <StackPanel Grid.Column="2"><TextBlock Text="ПОЛУЧЕНО" Style="{StaticResource Sub}" FontSize="11" LineHeight="15"/><TextBlock x:Name="Downloaded" Text="0 Б" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel>
     </Grid></Border>
     <Border Style="{StaticResource Card}" Padding="20,14" Margin="0"><DockPanel><Button DockPanel.Dock="Right" Content="Мой доступ" Click="OpenAccess" Margin="16,0,0,0" MinHeight="42" Padding="18,9"/><StackPanel VerticalAlignment="Center"><TextBlock Text="Персональный ключ" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="KeyStatus" Text="Ключ не добавлен" Style="{StaticResource Sub}" FontSize="14" LineHeight="19" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
    </StackPanel>
    <StackPanel x:Name="Access" Visibility="Collapsed">
     <TextBlock Text="Персональный доступ" Style="{StaticResource Heading}"/><TextBlock Text="Ваш ключ хранится только на этом компьютере." Style="{StaticResource Sub}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
      <TextBlock Text="Ключ активации" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Вставьте ключ или QR-ссылку из бота. Адреса и порты вводить не нужно." Style="{StaticResource Sub}" Margin="0,8,0,14"/>
      <TextBlock Text="Ключ или QR-ссылка" Margin="0,0,0,6"/><PasswordBox x:Name="KeyInput" MaxLength="8192" AutomationProperties.Name="Ключ или QR-ссылка"/>
      <Grid Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="SaveButton" Content="Сохранить ключ" Style="{StaticResource Primary}" Click="SaveKey"/><Button Grid.Column="2" Content="Получить QR в боте" Click="OpenBot"/>
      </Grid>
     </StackPanel></Border>
     <TextBlock Text="Windows DPAPI шифрует ключ для вашего пользователя. При обновлении прежний ключ и идентификатор устройства сохраняются." Style="{StaticResource Sub}" FontSize="13" LineHeight="19"/>
     <TextBlock x:Name="AccessNotice" Style="{StaticResource Sub}" Margin="0,10,0,0"/>
    </StackPanel>
    <StackPanel x:Name="Protocol" Visibility="Collapsed">
     <TextBlock Text="Протокол VPN" Style="{StaticResource Heading}"/><TextBlock Text="Выбор применяется при следующем подключении." Style="{StaticResource Sub}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12"><DockPanel><Button x:Name="ChooseAuto" DockPanel.Dock="Right" Width="150" MinHeight="44" Padding="12,9" Content="Выбрать AUTO" Tag="auto" Click="ChooseProtocol" Margin="16,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="AUTO" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Приложение само проверяет KS и CITP и подключает тот, что работает в вашей сети. Запоминает удачный вариант." Style="{StaticResource Sub}" FontSize="13" LineHeight="18" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
     <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12"><DockPanel><Button x:Name="ChooseCitp" DockPanel.Dock="Right" Width="150" MinHeight="44" Padding="12,9" Content="Выбрать CITP" Tag="citp" Click="ChooseProtocol" Margin="16,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="CITP" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Защищённый мультиплексированный транспорт поверх TCP. Устойчив в строгих сетях." Style="{StaticResource Sub}" FontSize="13" LineHeight="18" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
     <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,0,12"><DockPanel><Button x:Name="ChooseKs" DockPanel.Dock="Right" Width="150" MinHeight="44" Padding="12,9" Content="Выбрать KS" Tag="ks" Click="ChooseProtocol" Margin="16,0,0,0"/><StackPanel VerticalAlignment="Center"><TextBlock Text="KS" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Быстрый транспорт через UDP. Нужны доступность UDP и точное системное время." Style="{StaticResource Sub}" FontSize="13" LineHeight="18" Margin="0,4,0,0"/></StackPanel></DockPanel></Border>
     <TextBlock x:Name="ProtocolNotice" Text="Для смены протокола сначала отключите VPN." Style="{StaticResource Sub}" FontSize="13" LineHeight="18"/>
    </StackPanel>
    <StackPanel x:Name="Diagnostics" Visibility="Collapsed">
     <TextBlock Text="Диагностика" Style="{StaticResource Heading}"/><TextBlock Text="Проверка службы, системных компонентов и этапа подключения." Style="{StaticResource Sub}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
      <TextBlock x:Name="DiagnosticTitle" Text="Проверяем службу" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock x:Name="DiagnosticCode" Text="Код: —" FontFamily="Consolas" FontSize="14" Margin="0,12,0,6"/>
      <TextBlock x:Name="DiagnosticDetail" Style="{StaticResource Sub}" FontSize="13" LineHeight="18" Height="72" TextTrimming="WordEllipsis"/>
      <TextBlock x:Name="SystemState" Style="{StaticResource Sub}" FontSize="12" LineHeight="17" Margin="0,8,0,0" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock x:Name="CheckedTime" Style="{StaticResource Sub}" FontSize="12" LineHeight="17" Margin="0,4,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="CheckButton" Content="Проверить и исправить" Style="{StaticResource Primary}" Click="Check"/><Button Grid.Column="2" Content="Копировать отчёт" Click="CopyReport"/>
      </Grid>
     </StackPanel></Border>
     <TextBlock Text="Отчёт не содержит ключей, токенов и истории трафика. Приложение работает с правами администратора: они нужны для адаптера Wintun, маршрутов, DNS и правил брандмауэра." Style="{StaticResource Sub}" FontSize="13" LineHeight="18"/>
     <TextBlock x:Name="CopyNotice" Style="{StaticResource Sub}" FontSize="13" Margin="0,6,0,0"/>
    </StackPanel>
    <StackPanel x:Name="Updates" Visibility="Collapsed">
     <TextBlock Text="Обновления" Style="{StaticResource Heading}"/><TextBlock Text="Новые версии загружаются только с официального сайта Chameleon." Style="{StaticResource Sub}" Margin="0,0,0,16"/>
     <Border Style="{StaticResource Card}" Padding="22"><StackPanel>
      <TextBlock x:Name="UpdateTitle" Text="Проверяем обновления" FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <TextBlock x:Name="UpdateDetail" Text="Связываемся с сайтом Chameleon…" Style="{StaticResource Sub}" FontSize="14" LineHeight="20" Margin="0,8,0,0" Height="60" TextTrimming="WordEllipsis"/>
      <TextBlock x:Name="InstalledVersion" Style="{StaticResource Sub}" FontSize="12" LineHeight="17" Margin="0,4,0,12" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"/>
      <ProgressBar x:Name="UpdateProgress" Height="4" Minimum="0" Maximum="1" Visibility="Hidden" Margin="0,0,0,14"/>
      <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <Button x:Name="UpdateButton" Content="Обновить" Style="{StaticResource Primary}" Click="InstallUpdate" IsEnabled="False"/><Button x:Name="CheckUpdateButton" Grid.Column="2" Content="Проверить обновления" Click="CheckUpdates"/>
      </Grid>
     </StackPanel></Border>
     <TextBlock Text="Установщик проверяется по размеру, контрольной сумме SHA-256 и версии. Перед установкой VPN отключается, после установки приложение откроется снова. Ключ и настройки сохраняются." Style="{StaticResource Sub}" FontSize="13" LineHeight="18"/>
    </StackPanel>
   </Grid>
  </DockPanel>
 </Grid>
 </Viewbox>
</Window>
