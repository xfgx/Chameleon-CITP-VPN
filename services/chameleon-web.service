[Unit]
Description=Chameleon public downloads and TLS-verified activation gateway
After=network-online.target
Wants=network-online.target

[Service]
User=chameleon-web
Group=chameleon-web
ExecStart=/usr/local/libexec/chameleon/vpn-web
LoadCredential=visitor_salt:/etc/chameleon/web/visitor-salt
LoadCredential=monitor_token:/etc/chameleon/web/monitor-token
StateDirectory=chameleon-web
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictNamespaces=yes
LockPersonality=yes
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
MemoryMax=256M
CPUQuota=50%
TasksMax=64
ReadOnlyPaths=/srv/chameleon/releases /etc/chameleon

[Install]
WantedBy=multi-user.target